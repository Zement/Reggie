# Others
log.txt

# Every settings variant, not just the two known names. QSettings writes a
# temporary 'settings.ini.<random>' while flushing and renames it into place;
# a run that does not exit cleanly leaves one behind. These hold local paths
# and must never be committed, so the pattern covers whatever Qt invents.
settings.ini
settings.ini.*
temp/

# Development and analysis files
reggiedata/patches/*
Reggie-Next.code-workspace

# Local workspace: docs, logs, meta (cascade/CLAUDE/workflow) and scratch scripts.
# Everything under here is developer-local and never committed. See _workspace/.
_workspace/

# Runtime logs written beside the application (collaboration debug logs, and
# anything a future unified logger writes).
#
# The folder travels, its contents never do - same shape as assets/mods below.
# The application creates logs/ on demand either way; keeping it in the tree
# means a fresh checkout has somewhere to write before anything runs, and means
# the layout is visible to someone reading the repository.
logs/*
!logs/.gitkeep

# Assets folder contents (keep folder structure only)
assets/mods/*
assets/snapshots/*
assets/qpt/presets/*

# Collaboration host identity (Block C-B1). These are generated per machine and
# collab_host_key.pem is a PRIVATE KEY - it must never be committed. They belong
# in the user profile; this is a backstop in case one is ever created in a
# checkout.
collab_host_cert.pem
collab_host_key.pem

